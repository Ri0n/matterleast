# Detect Windows DLL imports after Qt deployment, before versioned relocation.
# Bundled QCA/qca-ossl are static, but qca-ossl links OpenSSL dynamically
# when the selected Windows OpenSSL SDK supplies import libraries.
set(_ml_bin "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/bin")
set(_ml_exe "${_ml_bin}/matterleast.exe")
if(NOT EXISTS "${_ml_exe}")
    message(FATAL_ERROR "Cannot scan missing MatterLeast runtime: ${_ml_exe}")
endif()

set(_ml_search
    "@OPENSSL_ROOT_DIR@/bin"
    "$ENV{ProgramFiles}/OpenSSL/bin"
    "$ENV{ProgramFiles}/OpenSSL-Win64/bin")
set(_ml_import "@OPENSSL_CRYPTO_LIBRARY@")
if(EXISTS "${_ml_import}")
    get_filename_component(_ml_walk "${_ml_import}" DIRECTORY)
    foreach(_ml_level RANGE 0 5)
        list(APPEND _ml_search "${_ml_walk}/bin")
        get_filename_component(_ml_walk "${_ml_walk}" DIRECTORY)
    endforeach()
endif()
list(REMOVE_DUPLICATES _ml_search)

file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${_ml_exe}"
    RESOLVED_DEPENDENCIES_VAR _ml_resolved
    UNRESOLVED_DEPENDENCIES_VAR _ml_unresolved
    DIRECTORIES ${_ml_search})

foreach(_ml_name IN LISTS _ml_unresolved)
    string(TOLOWER "${_ml_name}" _ml_lower)
    if(_ml_lower MATCHES "^(libssl|libcrypto|libtls|ssleay|libeay).*\\.dll$")
        message(FATAL_ERROR "Missing OpenSSL DLL required by MatterLeast: ${_ml_name}")
    endif()
endforeach()

set(_ml_ssl FALSE)
set(_ml_crypto FALSE)
foreach(_ml_file IN LISTS _ml_resolved)
    get_filename_component(_ml_name "${_ml_file}" NAME)
    string(TOLOWER "${_ml_name}" _ml_lower)
    if(_ml_lower MATCHES "^(libssl|libcrypto|libtls|ssleay|libeay).*\\.dll$")
        if(_ml_lower MATCHES "^(libssl|ssleay)")
            set(_ml_ssl TRUE)
        elseif(_ml_lower MATCHES "^(libcrypto|libeay)")
            set(_ml_crypto TRUE)
        endif()
        if(NOT EXISTS "${_ml_bin}/${_ml_name}")
            file(COPY_FILE "${_ml_file}" "${_ml_bin}/${_ml_name}")
        endif()
        message(STATUS "Deployed OpenSSL runtime: ${_ml_name}")
    endif()
endforeach()
if(_ml_ssl AND NOT _ml_crypto)
    message(FATAL_ERROR "OpenSSL SSL DLL found but crypto DLL is missing")
endif()
message(STATUS "MatterLeast Windows SSL runtime dependencies scanned")
